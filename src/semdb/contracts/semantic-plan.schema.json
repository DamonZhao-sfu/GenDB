{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gendb.local/semdb/semantic-plan.schema.json",
  "title": "SemDB semantic plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "query_id",
    "plan_version",
    "parent_plan_version",
    "modality",
    "compilability",
    "semantic_sites",
    "helper_dag",
    "relational_plan",
    "trace_contract",
    "runtime_contract",
    "validation_contract",
    "assumptions",
    "invariants"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "query_id": { "type": "string", "minLength": 1 },
    "plan_version": { "type": "integer", "minimum": 1 },
    "parent_plan_version": {
      "anyOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "null" }
      ]
    },
    "modality": { "enum": ["image", "text", "mixed"] },
    "compilability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "obligations", "unresolved"],
      "properties": {
        "class": {
          "enum": ["exact", "bounded_approximation", "not_compilable"]
        },
        "obligations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "unresolved": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "semantic_sites": {
      "type": "array",
      "items": { "$ref": "#/$defs/semanticSite" }
    },
    "helper_dag": {
      "type": "array",
      "items": { "$ref": "#/$defs/helperNode" }
    },
    "relational_plan": {
      "type": "array",
      "items": {
        "anyOf": [
          { "type": "string", "minLength": 1 },
          { "type": "object" }
        ]
      }
    },
    "trace_contract": { "type": "object" },
    "runtime_contract": { "type": "object" },
    "validation_contract": { "type": "object" },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "invariants": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "typedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 }
      }
    },
    "semanticInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table", "column", "type"],
      "properties": {
        "table": { "type": "string", "minLength": 1 },
        "column": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 }
      }
    },
    "semanticSite": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "site_id",
        "operator",
        "predicate",
        "inputs",
        "sampling_unit",
        "output_type",
        "value_space"
      ],
      "properties": {
        "site_id": { "type": "string", "minLength": 1 },
        "operator": { "type": "string", "minLength": 1 },
        "predicate": { "type": "string" },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/semanticInput" }
        },
        "sampling_unit": {
          "enum": ["row", "pair", "ordered_pair", "tuple", "group"]
        },
        "output_type": { "type": "string", "minLength": 1 },
        "value_space": {
          "anyOf": [
            { "type": "array" },
            { "type": "object" },
            { "type": "string" },
            { "type": "null" }
          ]
        }
      }
    },
    "primitiveStep": {
      "type": "object",
      "additionalProperties": true,
      "required": ["primitive", "source", "inputs", "output_type"],
      "properties": {
        "primitive": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "inputs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "output_type": { "type": "string", "minLength": 1 }
      }
    },
    "confidenceSignal": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source", "range", "higher_is_more_confident"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "range": {
          "type": "array",
          "prefixItems": [{ "type": "number" }, { "type": "number" }],
          "minItems": 2,
          "maxItems": 2
        },
        "higher_is_more_confident": { "type": "boolean" }
      }
    },
    "helperNode": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "helper_id",
        "name",
        "args",
        "return_type",
        "depends_on",
        "primitive_steps",
        "confidence_signal"
      ],
      "properties": {
        "helper_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "items": { "$ref": "#/$defs/typedValue" }
        },
        "return_type": { "type": "string", "minLength": 1 },
        "depends_on": {
          "type": "array",
          "items": { "type": "string" }
        },
        "primitive_steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/primitiveStep" }
        },
        "confidence_signal": {
          "anyOf": [
            { "$ref": "#/$defs/confidenceSignal" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
