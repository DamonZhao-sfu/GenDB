{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gendb.local/semdb/optimizer-action.schema.json",
  "title": "SemDB optimizer action",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "query_id",
    "candidate_id",
    "action",
    "diagnosis",
    "targets",
    "preserve",
    "expected_effect"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "query_id": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "action": { "enum": ["PATCH_CODE", "REPLAN", "STOP"] },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "summary", "evidence"],
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact", "symbol", "intent"],
        "properties": {
          "artifact": { "enum": ["plan", "helpers", "solver"] },
          "symbol": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "intent": { "type": "string", "minLength": 1 }
        }
      }
    },
    "preserve": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "expected_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_metric", "direction", "risk"],
      "properties": {
        "primary_metric": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["increase", "decrease", "unchanged", "unknown"] },
        "risk": { "type": "string" }
      }
    },
    "replan_reason": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "action": { "const": "PATCH_CODE" } },
        "required": ["action"]
      },
      "then": {
        "properties": {
          "replan_reason": false,
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "artifact": { "enum": ["helpers", "solver"] }
              },
              "required": ["artifact"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "action": { "const": "REPLAN" } },
        "required": ["action"]
      },
      "then": {
        "properties": {
          "replan_reason": { "type": "string", "minLength": 1 },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "artifact": { "const": "plan" }
              },
              "required": ["artifact"]
            }
          }
        },
        "required": ["replan_reason"]
      }
    },
    {
      "if": {
        "properties": { "action": { "const": "STOP" } },
        "required": ["action"]
      },
      "then": {
        "properties": {
          "replan_reason": false,
          "targets": { "type": "array", "maxItems": 0 }
        }
      }
    }
  ]
}
