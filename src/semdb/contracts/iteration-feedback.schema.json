{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gendb.local/semdb/iteration-feedback.schema.json",
  "title": "SemDB iteration feedback",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "query_id",
    "candidate_id",
    "iteration",
    "execution",
    "objective",
    "operator_fidelity",
    "errors",
    "runtime_branches",
    "history",
    "data_boundary"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "query_id": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "iteration": { "type": "integer", "minimum": 0 },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "stage", "preflight", "stderr_tail", "runtime_ms"],
      "properties": {
        "status": { "enum": ["ok", "crash", "empty"] },
        "stage": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "preflight": {
          "anyOf": [{ "type": "object" }, { "type": "null" }]
        },
        "stderr_tail": { "type": "string" },
        "runtime_ms": {
          "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
        },
        "selected_rows": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "value",
        "precision",
        "recall",
        "weighted",
        "direction",
        "scope",
        "details"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": {
          "anyOf": [{ "type": "number" }, { "type": "null" }]
        },
        "precision": {
          "anyOf": [{ "type": "number" }, { "type": "null" }]
        },
        "recall": {
          "anyOf": [{ "type": "number" }, { "type": "null" }]
        },
        "weighted": { "type": "boolean" },
        "direction": { "enum": ["maximize", "minimize"] },
        "scope": {
          "enum": ["query_metric", "operator_fidelity", "unavailable"]
        },
        "details": { "type": "object" }
      }
    },
    "operator_fidelity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accuracy",
        "precision",
        "recall",
        "f1",
        "n",
        "correct",
        "weighted"
      ],
      "properties": {
        "accuracy": {
          "anyOf": [{ "type": "number" }, { "type": "null" }]
        },
        "precision": {
          "anyOf": [{ "type": "number" }, { "type": "null" }]
        },
        "recall": {
          "anyOf": [{ "type": "number" }, { "type": "null" }]
        },
        "f1": {
          "anyOf": [{ "type": "number" }, { "type": "null" }]
        },
        "n": {
          "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
        },
        "correct": {
          "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
        },
        "weighted": { "type": "boolean" }
      }
    },
    "errors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "false_positive_total",
        "false_negative_total",
        "mismatch_total",
        "mistakes"
      ],
      "properties": {
        "kind": {
          "enum": [
            "classification",
            "label_mismatch",
            "metric_specific",
            "execution"
          ]
        },
        "false_positive_total": {
          "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
        },
        "false_negative_total": {
          "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
        },
        "mismatch_total": {
          "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
        },
        "mistakes": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },
    "runtime_branches": { "type": "object" },
    "trace_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "entries",
        "true_count",
        "false_count",
        "other_count",
        "distinct_values",
        "omitted_distinct_values"
      ],
      "properties": {
        "status": { "enum": ["ok", "missing"] },
        "entries": { "type": "integer", "minimum": 0 },
        "true_count": { "type": "integer", "minimum": 0 },
        "false_count": { "type": "integer", "minimum": 0 },
        "other_count": { "type": "integer", "minimum": 0 },
        "distinct_values": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "count"],
            "properties": {
              "value": { "type": "string" },
              "count": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "omitted_distinct_values": { "type": "integer", "minimum": 0 }
      }
    },
    "history": {
      "type": "array",
      "items": { "type": "object" }
    },
    "data_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "cert_accessed", "full_ground_truth_accessed"],
      "properties": {
        "source": {
          "enum": ["select_validation", "none"]
        },
        "cert_accessed": { "const": false },
        "full_ground_truth_accessed": { "const": false }
      }
    }
  }
}
